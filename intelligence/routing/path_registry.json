{
  "version": 1,
  "paths": [
    {
      "id": "daily_review",
      "label": "全量复盘",
      "kind": "known_workflow",
      "description": "同步/读取盘面数据，生成每日复盘、theme candidates、backfill queue 和复盘工作台。",
      "triggers": ["全量复盘", "每日复盘", "日复盘", "盘面复盘", "daily review", "daily-review", "daily"],
      "inputs": ["trade_date"],
      "outputs": ["daily-review.md", "theme-candidates.json", "theme-backfill-queue.json", "复盘 HTML"],
      "command_template": "python3 -m intelligence.cli daily --date {date}",
      "auto_execute": false,
      "risk_level": "medium",
      "notes": "涉及数据同步和文件输出；周末/非交易日应优先切到最近交易日。"
    },
    {
      "id": "daily_ops_ledger",
      "label": "每日作战台账",
      "kind": "known_workflow",
      "description": "只读扫描当日复盘、晨汇、IMA、relations 和结构债状态，生成 JSON/Markdown 台账。",
      "triggers": ["台账", "daily ops", "ledger", "状态面板", "今天缺什么", "查漏补缺"],
      "inputs": ["date", "knowledge_wiki"],
      "outputs": ["daily-ops-ledger.json", "daily-ops-ledger.md"],
      "command_template": "python3 scripts/build_daily_ops_ledger.py --date {date} --knowledge-wiki {knowledge_wiki}",
      "auto_execute": true,
      "risk_level": "low",
      "notes": "只读扫描，可以作为每日入口。"
    },
    {
      "id": "morning_briefing_ingest",
      "label": "晨汇入库",
      "kind": "known_workflow",
      "description": "把早上的晨汇作为新逻辑来源入库，并进入交叉分析与催化跟踪。",
      "triggers": ["晨汇", "早报", "盘前", "早会", "morning briefing", "morning"],
      "inputs": ["briefing_file", "date"],
      "outputs": ["wiki/briefings", "cross-analysis", "catalyst_calendar"],
      "command_template": "",
      "auto_execute": false,
      "risk_level": "medium",
      "notes": "需要先固定晨汇 inbox 目录后再自动化。"
    },
    {
      "id": "sellside_digest_ingest",
      "label": "晚间卖方研报入库",
      "kind": "known_workflow",
      "description": "处理晚间卖方摘要/研报，把行业逻辑、个股逻辑、交叉观点和提及频次拆开。",
      "triggers": ["卖方", "研报", "晚间研报", "报告入库", "sellside", "digest"],
      "inputs": ["report_file_or_folder"],
      "outputs": ["source/raw", "concept/entity delta", "sellside cross", "mention_frequency"],
      "command_template": "",
      "auto_execute": false,
      "risk_level": "medium",
      "notes": "卖方观点不是硬事实，默认需要证据层标记。"
    },
    {
      "id": "ima_stock_ingest",
      "label": "IMA 个股卡入库",
      "kind": "known_workflow",
      "description": "把 IMA 生成的个股逻辑卡写入 source/entity/evidence/raw。",
      "triggers": ["IMA", "ima", "个股卡", "个股逻辑卡", "逻辑卡", "个股入库"],
      "inputs": ["stock_card_folder"],
      "outputs": ["wiki/sources", "wiki/entities", "relations/evidence_index", "raw/ima-stock"],
      "command_template": "",
      "auto_execute": false,
      "risk_level": "medium",
      "notes": "已入库/未入库/待人工确认目录状态由 daily_ops_ledger 监控。"
    },
    {
      "id": "concept_backfill",
      "label": "概念归一与补齐",
      "kind": "known_workflow",
      "description": "处理 missing concept、别名归一、概念页生成、图谱登记。",
      "triggers": ["missing concept", "缺 concept", "缺概念", "概念归一", "概念补齐", "别名判断"],
      "inputs": ["missing_concept_audit"],
      "outputs": ["wiki/concepts", "relations/concept_graph", "relations/aliases"],
      "command_template": "",
      "auto_execute": false,
      "risk_level": "high",
      "notes": "不能盲目 DeepDive；先判断是否真实概念、别名、污染词。"
    },
    {
      "id": "source_backfill",
      "label": "source/raw 追溯补齐",
      "kind": "known_workflow",
      "description": "处理 missing source、source manifest、legacy-untraced stub 和 raw 归档。",
      "triggers": ["missing source", "缺 source", "缺 raw", "source manifest", "legacy source", "可追溯"],
      "inputs": ["missing_source_audit", "raw_folder"],
      "outputs": ["wiki/sources", "wiki/raw", "evidence source trace"],
      "command_template": "",
      "auto_execute": false,
      "risk_level": "high",
      "notes": "找得到原文先补 raw/source；找不到才建 legacy-untraced。"
    },
    {
      "id": "front_map",
      "label": "Theme Radar Front Map",
      "kind": "known_workflow",
      "description": "做题材前瞻信息地图，适合看覆盖度、信号水位、公司地图。",
      "triggers": ["front-map", "frontmap", "信息地图", "前瞻地图", "信号地图", "公司地图", "覆盖度"],
      "inputs": ["theme"],
      "outputs": ["front-map report"],
      "command_template": "python3 -m intelligence.cli ask {query} --modules front-map",
      "auto_execute": true,
      "risk_level": "low",
      "notes": "适合已知题材的结构化扫图，不替代 deep-dive。"
    },
    {
      "id": "deep_dive",
      "label": "Theme Radar Deep Dive",
      "kind": "known_workflow",
      "description": "做题材深拆，适合共振分层、预期差、验证清单。",
      "triggers": ["deep-dive", "deepdive", "深拆", "深度", "深研", "全面分析"],
      "inputs": ["theme"],
      "outputs": ["deep-dive report"],
      "command_template": "python3 -m intelligence.cli ask {query} --modules deep-dive",
      "auto_execute": true,
      "risk_level": "low",
      "notes": "只适合已命名题材；不要用它解决 missing concept 污染。"
    },
    {
      "id": "logic_market_match",
      "label": "逻辑-盘面匹配",
      "kind": "planner_analysis",
      "description": "把 theme-candidates 和知识库 concept/entity/evidence 对齐，判断旧逻辑唤醒、新逻辑、噪音或补库任务。",
      "triggers": ["为什么动", "为什么涨", "异动", "旧逻辑", "唤醒", "兑现", "共振", "新逻辑", "噪音"],
      "inputs": ["theme_or_stock", "trade_date", "theme-candidates", "knowledge graph"],
      "outputs": ["旧逻辑唤醒/新逻辑/噪音/缺口队列"],
      "command_template": "python3 -m intelligence.cli logic-match {query} --date {date}",
      "auto_execute": false,
      "risk_level": "medium",
      "notes": "优先用于把盘面异动分诊为旧逻辑唤醒、新逻辑、噪音或补库任务。"
    }
  ]
}
