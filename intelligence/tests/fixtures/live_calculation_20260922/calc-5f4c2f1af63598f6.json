  "script": "sub = '600519.SH'\nocf = {x['as_of']: x['value'] for x in series(sub, 'ocf_cum_yi')}\nnp_ = {x['as_of']: x['value'] for x in series(sub, 'net_profit_cum_yi')}\ndisc = {'2025-03-31':'2025-04-30','2025-06-30':'2025-08-13','2025-09-30':'2025-10-30','2025-12-31':'2026-04-17','2026-03-31':'2026-04-25','2026-06-30':'2026-08-15'}\nlabel = {'2025-03-31':'2025一季报','2025-06-30':'2025中报','2025-09-30':'2025三季报','2025-12-31':'2025年报','2026-03-31':'2026一季报','2026-06-30':'2026中报'}\nrows = []\nnotes = []\nfor d in sorted(label):\n    o = ocf.get(d); n = np_.get(d)\n    r = safe_div(o, n)\n    if o is None or n is None:\n        notes.append(f'{label[d]} 缺数：ocf={o}, np={n}')\n    rows.append({'报告期': label[d], '报告期截止日': d, '披露日': disc[d],\n                 '累计经营现金流净额（亿元）': o, '累计归母净利润（亿元）': n,\n                 '现金流/净利润': round(r, 4) if r is not None else None})\nratios = [r['现金流/净利润'] for r in rows if r['现金流/净利润'] is not None]\nemit_result(\n    summary={'六期平均比值': round(sum(ratios)/len(ratios), 4) if ratios else None,\n             '最高比值': max(ratios) if ratios else None,\n             '最低比值': min(ratios) if ratios else None,\n             '六期合计现金流（亿元）': round(sum(r['累计经营现金流净额（亿元）'] for r in rows if r['累计经营现金流净额（亿元）'] is not None), 2),\n             '六期合计归母净利润（亿元）': round(sum(r['累计归母净利润（亿元）'] for r in rows if r['累计归母净利润（亿元）'] is not None), 2)},\n    tables=[table('茅台六期含金量', ['报告期','报告期截止日','披露日','累计经营现金流净额（亿元）','累计归母净利润（亿元）','现金流/净利润'], rows, unit='亿元', note='均为累计口径；比值为经营现金流净额÷归母净利润')],\n    formulas=['现金流/净利润 = ocf_cum_yi / net_profit_cum_yi'],\n    notes=notes)",
