<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  已退役：feishu-bot 现在 exit 2，不要 launchctl load。
  若本机曾经装过，请 unload：
    launchctl unload ~/Library/LaunchAgents/com.financeworkspace.feishu-bot.plist
  KeepAlive 已改为 false，避免误 load 后每 10 秒重启。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.financeworkspace.feishu-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>intelligence.cli</string>
        <string>feishu-bot</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <!-- 凭证若走环境变量，取消注释并填值（更推荐放 feishu_config.json，避免 plist 落盘密钥）
    <key>EnvironmentVariables</key>
    <dict>
        <key>FEISHU_APP_ID</key>
        <string>cli_xxxxxxxxxxxx</string>
        <key>FEISHU_APP_SECRET</key>
        <string>xxxxxxxxxxxxxxxxxxxxxx</string>
    </dict>
    -->

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/logs/feishu-bot.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/logs/feishu-bot.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
