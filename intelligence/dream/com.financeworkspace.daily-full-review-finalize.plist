<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd：每日 20:40 全量复盘 - finalize 段（L2 + 生成）。
  仓内源；装机副本由 scripts/install_eval_launchd.sh 同步。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.financeworkspace.daily-full-review-finalize</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/a77/.local/bin/nightly_full_review.sh</string>
    <string>finalize</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/a77/finance-workspace-private</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- L2 / 质检 / 方法保持现行快照；生成单独冻结，禁止用旧生成整树覆盖 L2。 -->
    <key>FINANCE_CODE_ROOT</key>
    <string>/Users/a77/.finance-runtime/finance-l2-d433b90788c0</string>
    <key>FINANCE_GENERATION_CODE_ROOT</key>
    <string>/Users/a77/.finance-runtime/finance-generation-387028b846a2</string>
    <key>FINANCE_DATA_ROOT</key>
    <string>/Users/a77/finance-workspace-private</string>
    <key>FINANCE_WS</key>
    <string>/Users/a77/finance-workspace-private</string>
    <key>FINANCE_PYTHON</key>
    <string>/Users/a77/finance-workspace-private/.venv-workbench/bin/python</string>
    <key>FINANCE_OPS_HEALTH_LOG</key>
    <string>/Users/a77/.finance-runtime/ops-health.log</string>
    <key>MARKET_FEATURE_STORE_DB</key>
    <string>/Users/a77/finance-workspace-private/db/market_feature_store.duckdb</string>
    <key>FORESIGHT_USERS_DIR</key>
    <string>/Users/a77/.local/share/finance-workbench/users</string>
    <key>FORESIGHT_USER</key>
    <string>linxiaoqi5111</string>
    <key>REVIEW_GATE_LOCK_ATTEMPTS</key>
    <string>36</string>
    <key>REVIEW_GATE_LOCK_DELAY_SECONDS</key>
    <string>10</string>
    <!-- finalize 也必须带档位（2026-09-12 补）：三道质检闸门（data / l2 / all）
         的 plan 参数缺省读这个变量，未设即按 full 期望裁判，plan=local 下不抓的
         fact_theme_flow_daily 会被判成断档 → 20:40 守卫中止 → 方法飞轮轮不到。
         装机副本此前手工加过 local，仓内源一直没有：重装就会静默丢掉它。
         与 sync 源保持同值，改档两份一起改。 -->
    <key>REVIEW_SYNC_PLAN</key>
    <string>local</string>
    <!-- 与独立 S7 同步任务保持记录一致；finalize 不调用 sync / all。 -->
    <key>FINANCE_SYNC_CODE_ROOT</key>
    <string>/Users/a77/finance-workspace-sync</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardErrorPath</key>
  <string>/Users/a77/finance-workspace-private/logs/daily-full-review.err.log</string>
  <key>StandardOutPath</key>
  <string>/Users/a77/finance-workspace-private/logs/daily-full-review.out.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
</dict>
</plist>
