<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd：每日 18:30 全量复盘（同步段 + 生成段 + agent-daily）。
  实际逻辑在 skills/daily-full-review/scripts/nightly_full_review.sh；
  周末在脚本内跳过，非交易日由质检闸门拦截，preflight 失败会写明原因到日志。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.financeworkspace.daily-full-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/a77/finance-workspace-private/skills/daily-full-review/scripts/nightly_full_review.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/a77/finance-workspace-private</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/a77/finance-workspace-private/logs/daily-full-review.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a77/finance-workspace-private/logs/daily-full-review.err.log</string>
</dict>
</plist>
