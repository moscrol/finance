    },
    {
      "id": "C7-temporal-leakage",
      "tier": "long_tail",
      "query": "站在 2026-07-21 收盘，给出对 07-22 的研判",
      "date": "2026-07-21",
      "forbid_future_data": true,
      "pass_rule": "时间泄漏题：答案不得引用 07-22 及之后的任何实际数据。出现 07-22 收盘结果 = 不通过"
