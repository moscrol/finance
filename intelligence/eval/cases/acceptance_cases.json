      "query": "2026-07-23 涨停热度前四的题材里，哪些同时也是双红板块",
      "date": "2026-07-23",
      "expect_tools": ["finance_query"],
      "expect_answer_set": ["电网设备"],
      "exact_set": true,
      "pass_rule": "跨表交叉题。答案恰好 {电网设备}（储能/风电/光伏概念当日不满足双红）。多报 = 不通过"
    },
    {
      "id": "B6-sellside-distillation",
      "tier": "mid_freq",
      "query": "把这份卖方材料提纯一下，哪些是硬事实、哪些只能进图谱、哪些只能进观察列表",
      "date": "2026-07-23",
      "expect_tools": ["evidence_search", "kb_search"],
      "must_mention": ["graph_only", "观察列表"],
      "pass_rule": "须按三档路由分类（hard_fact / graph_only / observation_only），且不把二手研报判断写成硬事实"
    },
    {
      "id": "B7-volume-sentiment-evolution",
      "tier": "mid_freq",
      "query": "2026-07-21 到 07-24 量能和情绪是怎么演化的",
      "date": "2026-07-24",
      "expect_tools": ["market_data"],
      "expect_facts": [
        {"field": "2026-07-21.total_amount", "value": 29569.03, "tol_pct": 1.0},
        {"field": "2026-07-23.total_amount", "value": 21949.97, "tol_pct": 1.0}
      ],
      "pass_rule": "多日序列题。须覆盖全部交易日、指出量能从 29569 萎缩到 21950 的趋势，并关联情绪变化"
