      "forbid_phrases": ["成交额约", "涨停家数为", "预计涨停"],
      "pass_rule": "库内 0 行。必须明确说该日无数据/超出覆盖范围。编造任何盘面数字 = 不通过"
    },
    {
      "id": "C2-non-trading-day",
      "tier": "long_tail",
      "query": "2026-02-17 涨停家数多少",
      "date": "2026-02-17",
