{
  "schema_version": "1.0",
  "_comment": "用户验收题清单（28 道）。进度只有一种口径：这 28 道里过了几道，且必须走用户真实点击的那条路径（ASK_CONTINUOUS_RUNTIME=on 的 /api 会话），不是单测、不是 dry-run、不是旁路 provider。tier=high_freq 是日常主力，long_tail 专考诚实度与脏数据识别。reference_answers 冻结 codex/knevo 的回答快照作为短期相对基准；快照一旦入库不得由被测方重新生成。",
  "reference_agents": ["codex", "knevo"],
  "reference_dir": "intelligence/eval/cases/reference_snapshots",
  "aggregate_gate": 0.0,
  "_gate_note": "aggregate_gate 暂设 0.0（仅记录不拦截）。等基线跑出来、知道真实通过率后再上调。",
  "cases": [
    {
      "id": "A1-market-overview",
      "tier": "high_freq",
      "query": "2026-07-23 今天市场怎么样",
      "date": "2026-07-23",
      "expect_tools": ["market_data"],
      "expect_facts": [
        {"field": "total_amount", "value": 21949.97, "tol_pct": 1.0},
        {"field": "amount_vs_yesterday_pct", "value": -17.27, "tol_abs": 0.5},
        {"field": "limit_up", "value": 116, "tol_abs": 2},
        {"field": "limit_down", "value": 2, "tol_abs": 1},
        {"field": "sh_index_pct_chg", "value": 0.25, "tol_abs": 0.05}
      ],
      "must_mention": ["缩量", "反弹阶段"],
      "pass_rule": "成交额/量能变化/涨停跌停/指数涨幅四项数字均落在容差内，且指出缩量特征与所处阶段"
    },
    {
      "id": "A2-next-day-call",
      "tier": "high_freq",
      "query": "2026-07-21 收盘了，明天怎么看",
      "date": "2026-07-21",
      "expect_tools": ["market_data", "mainline_context"],
      "must_mention": ["证伪"],
      "require_falsifiable": true,
      "pass_rule": "必须给出方向判断 + 至少一个可证伪条件（含具体数值阈值，如指数点位或个股价格）。只给方向不给证伪条件 = 不通过"
    },
    {
      "id": "A3-stock-deep-dive",
      "tier": "high_freq",
      "query": "立新能源怎么看",
      "date": "2026-07-23",
      "expect_tools": ["finance_query", "market_data"],
      "expect_entities": ["立新能源"],
      "expect_facts": [
        {"field": "close", "value": 12.11, "tol_pct": 1.0},
        {"field": "boards", "value": 6, "tol_abs": 0}
      ],
      "pass_rule": "认出它是当日最高连板（6板），收盘价正确，且给出连板高度对应的风险提示"
    },
    {
      "id": "A4-dual-red",
      "tier": "high_freq",
      "query": "2026-07-23 哪些板块是双红",
      "date": "2026-07-23",
      "expect_tools": ["finance_query"],
      "expect_answer_set": ["电网设备"],
      "expect_facts": [
        {"field": "pct_chg", "value": 6.65, "tol_abs": 0.1},
        {"field": "diff_ratio", "value": 55.2, "tol_abs": 1.0},
        {"field": "amount", "value": 502, "tol_pct": 2.0}
      ],
      "exact_set": true,
      "pass_rule": "答案集合恰好等于 {电网设备}，三个指标数字正确。多报或少报任一板块 = 不通过"
    },
    {
      "id": "A5-limit-heat",
      "tier": "high_freq",
      "query": "2026-07-23 涨停集中在哪些题材",
      "date": "2026-07-23",
      "expect_tools": ["finance_query"],
      "expect_answer_set": ["储能", "风电", "电网设备", "光伏概念"],
      "expect_facts": [
        {"field": "储能.limit_up_count", "value": 40, "tol_abs": 1},
        {"field": "风电.limit_up_count", "value": 29, "tol_abs": 1}
      ],
      "pass_rule": "top4 题材命中至少 3 个，且储能为第一且家数正确"
    },
    {
      "id": "A6-limit-advance-ladder",
      "tier": "high_freq",
      "query": "2026-07-23 连板梯队什么情况，有没有断层",
      "date": "2026-07-23",
      "expect_tools": ["finance_query"],
      "expect_entities": ["立新能源"],
      "expect_facts": [{"field": "max_boards", "value": 6, "tol_abs": 0}],
      "must_mention": ["断层"],
      "pass_rule": "最高连板 6 板且个股正确，指出梯队稀薄/断层（当日 6/4/3/2 板合计仅约 15 只）"
    },
    {
      "id": "A7-mainline",
      "tier": "high_freq",
      "query": "2026-07-21 当天主线是什么",
      "date": "2026-07-21",
      "expect_tools": ["mainline_context", "finance_query"],
      "expect_answer_set": ["半导体"],
      "expect_facts": [
        {"field": "芯片概念.limit_up_count", "value": 66, "tol_abs": 2},
        {"field": "industry_1_ratio", "value": 31.1, "tol_abs": 1.0}
      ],
      "pass_rule": "识别半导体/芯片为主线，并用涨停家数或行业成交占比之一作为量化支撑"
    },
    {
      "id": "A8-market-stage",
      "tier": "high_freq",
      "query": "现在市场处于什么阶段，第几天了",
      "date": "2026-07-23",
      "expect_tools": ["market_data"],
      "expect_facts": [
        {"field": "market_stage", "value": "反弹阶段"},
        {"field": "stage_day", "value": 3, "tol_abs": 0}
      ],
      "pass_rule": "阶段名称与天数都正确"
    },
    {
      "id": "A9-sentiment-contradiction",
      "tier": "high_freq",
      "query": "2026-07-23 的市场情绪怎么解读",
      "date": "2026-07-23",
      "expect_tools": ["market_data"],
      "expect_facts": [
        {"field": "strength_marginal_pct", "value": -66.3, "tol_abs": 1.0},
        {"field": "strength_status", "value": "沸点"}
      ],
      "require_flag_inconsistency": true,
      "pass_rule": "陷阱题：边际强度 -66.3% 与状态『沸点』互相矛盾。必须指出这个矛盾。直接照抄『沸点』当结论 = 不通过"
    },
    {
      "id": "A10-new-high-structure",
      "tier": "high_freq",
      "query": "2026-07-21 的新高家数结构说明什么",
      "date": "2026-07-21",
      "expect_tools": ["market_data"],
      "expect_facts": [
        {"field": "stock_high_count_20d", "value": 339, "tol_abs": 5},
        {"field": "stock_high_count_1y", "value": 13, "tol_abs": 2}
      ],
      "pass_rule": "陷阱题：须对比短期与长期新高的巨大落差（20日 339 vs 1年 13），推出『反弹初期、尚未走出长期新高』。只报数字不做结构解读 = 部分通过"
    },
    {
      "id": "B1-theme-photoresist",
      "tier": "mid_freq",
      "query": "光刻胶",
      "date": "2026-06-11",
      "inherit_from": "intelligence/eval/cases/agent_cases.json#photoresist",
      "pass_rule": "沿用已有 golden case 判定（entity recall ≥ 0.5、引用真实性、免责声明）"
    },
    {
      "id": "B2-theme-liquid-cooling",
      "tier": "mid_freq",
      "query": "液冷",
      "date": "2026-06-11",
      "inherit_from": "intelligence/eval/cases/agent_cases.json#liquid-cooling",
      "pass_rule": "沿用已有 golden case 判定，含两轮追问一致性"
    },
    {
      "id": "B3-theme-solid-state-battery",
      "tier": "mid_freq",
      "query": "固态电池",
      "date": "2026-06-11",
      "inherit_from": "intelligence/eval/cases/agent_cases.json#solid-state-battery",
      "pass_rule": "沿用已有 golden case，重点看 forbid_entities（跨题材误归因）与 forbid_phrases（越级断言）是否触发"
    },
    {
      "id": "B4-fermentation-trace",
      "tier": "mid_freq",
      "query": "电网设备是怎么发酵到 2026-07-23 双红的，把链路回溯一下",
