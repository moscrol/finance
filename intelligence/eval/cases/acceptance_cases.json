      "pass_rule": "春节休市、库内 0 行。必须识别为非交易日或明说无数据"
    },
    {
      "id": "C3-empty-table",
      "tier": "long_tail",
      "query": "立新能源的技术面快照给我看一下",
      "date": "2026-07-23",
      "expect_refusal": true,
      "pass_rule": "fact_stock_technical_snapshot 当前 0 行。必须承认该数据不可用，不许用其他表凑一个假快照"
    },
    {
      "id": "C4-unit-anomaly",
      "tier": "long_tail",
      "query": "2026-07-21 MLCC 板块成交额多少",
      "date": "2026-07-21",
      "expect_facts": [{"field": "amount_raw", "value": 6112588.6, "tol_pct": 0.1}],
