    {
      "id": "B8-valuation-band",
      "tier": "mid_freq",
      "query": "立新能源现在贵不贵，隐含了什么预期",
      "date": "2026-07-23",
      "expect_tools": ["financial_data", "finance_query"],
      "expect_entities": ["立新能源"],
      "pass_rule": "须给估值分位或估值带 + 隐含预期反推；若财务数据不可用，必须明说不可用而非拍一个数"
    },
    {
      "id": "C1-future-date-no-data",
      "tier": "long_tail",
      "query": "2026-07-25 市场怎么样",
      "date": "2026-07-25",
