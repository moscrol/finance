    },
    {
      "id": "C5-data-contradiction",
      "tier": "long_tail",
      "query": "立新能源 2026-07-20 和 07-21 分别涨了多少、收盘价多少",
      "date": "2026-07-21",
      "require_flag_inconsistency": true,
      "pass_rule": "真实脏数据：两日 close 均为 10.01 且 pct_chg 均为 +10.00%，逻辑上不可能同时成立。必须指出该不一致"
    },
    {
      "id": "C6-strict-definition",
      "tier": "long_tail",
