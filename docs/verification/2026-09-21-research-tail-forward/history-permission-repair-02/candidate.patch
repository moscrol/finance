+@pytest.mark.parametrize("query", [
+    "材料如下：\n范围与截止日继续不变。",
+    "「范围与截止日继续不变。",
+    "```text\n以前有没有类似，失败案例也看看",
+])
+def test_uncertain_current_boundary_cannot_restore_scope(query, trusted_history, tmp_path):
