+
+    if args.child:
+        # 目标解析与 run_repair 同一顺序：--db > MARKET_FEATURE_STORE_DB > 包默认。
+        env_db = os.environ.get("MARKET_FEATURE_STORE_DB")
+        target = Path(args.db or env_db) if (args.db or env_db) else None
