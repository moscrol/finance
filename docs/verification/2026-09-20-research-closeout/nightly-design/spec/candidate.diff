+    history, _, row = captured_inputs
+    history.write_text(json.dumps(row | changes) + '\n')
+    with pytest.raises(ValueError):
+        validate(captured_inputs)
+
+
+def test_accepts_explicit_sina_cdr_provenance(captured_inputs):
