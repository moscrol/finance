  "script": "sub = '600519.SH'\nocf = {x['as_of']: x['value'] for x in series(sub, 'ocf_cum_yi')}\nnp_ = {x['as_of']: x['value'] for x in series(sub, 'net_profit_cum_yi')}\nperiods = sorted(set(ocf) & set(np_))\nlabel = {'2025-03-31':'2025一季报','2025-06-30':'2025中报','2025-09-30':'2025三季报','2025-12-31':'2025年报','2026-03-31':'2026一季报','2026-06-30':'2026中报'}\ndisclose = {'2025-03-31':'2025-04-30','2025-06-30':'2025-08-13','2025-09-30':'2025-10-30','2025-12-31':'2026-04-17','2026-03-31':'2026-04-25','2026-06-30':'2026-08-15'}\nrows = []\nfor p in periods:\n    o, n = ocf[p], np_[p]\n    r = safe_div(o, n)\n    rows.append({'报告期': label.get(p, p), '报告期截止日': p, '披露日': disclose.get(p),\n                 '累计经营现金流净额（亿元）': o, '累计归母净利润（亿元）': n,\n                 'OCF/归母净利润': round(r, 4) if r is not None else None})\nratios = [row['OCF/归母净利润'] for row in rows if row['OCF/归母净利润'] is not None]\navg_ratio = sum(ratios)/len(ratios) if ratios else None\nemit_result(\n    summary={'期数': len(rows), '六期平均OCF/归母净利润': round(avg_ratio, 4) if avg_ratio is not None else None,\n             '最低比值期': min(rows, key=lambda r: r['OCF/归母净利润'])['报告期'] if ratios else None,\n             '最高比值期': max(rows, key=lambda r: r['OCF/归母净利润'])['报告期'] if ratios else None},\n    tables=[table('茅台六期现金流含金量', ['报告期','报告期截止日','披露日','累计经营现金流净额（亿元）','累计归母净利润（亿元）','OCF/归母净利润'], rows, unit='亿元')],\n    formulas=['OCF/归母净利润 = 累计经营活动现金流量净额 ÷ 累计归母净利润'],\n    notes=['两项均为报告期累计口径，同一报告期相除；缺值不填0不外推'])",
