{
  "file": "intelligence/services/finance_query.py",
  "pytest": "intelligence/tests/test_market_measurement_contract.py",
  "mutants": [
    {
      "name": "mainline source value pretends to be billions",
      "old": "_metric(\"amount\", \"成交额（源值，单位未核验）\", \"sum\")",
      "new": "_metric(\"amount\", \"成交额亿\", \"sum\")",
      "expected_red": ["test_unverified_money_units_are_not_invented_from_magnitude[mainline-amount]"]
    },
    {
      "name": "mainline money flow gets an unproven unit",
      "old": "_metric(\"net_inflow_1d\", \"1日净流入（源值，单位未核验）\", \"sum\")",
      "new": "_metric(\"net_inflow_1d\", \"1日净流入亿元\", \"sum\")",
      "expected_red": ["test_unverified_money_units_are_not_invented_from_magnitude[mainline-flow]"]
    },
    {
      "name": "leader seal borrows another dataset unit",
      "old": "_metric(\"fd_amount\", \"封单额（源值，单位未核验）\", \"max\")",
      "new": "_metric(\"fd_amount\", \"封单额万元\", \"max\")",
      "expected_red": ["test_unverified_money_units_are_not_invented_from_magnitude[leader-seal]"]
    },
    {
      "name": "turnover is treated as new funding",
      "old": "不能单独证明增量资金入场",
      "new": "可以单独证明增量资金入场",
      "expected_red": ["test_market_totals_describe_activity_not_fund_origin_or_completed_liquidation"]
    },
    {
      "name": "foreign date becomes proof of availability",
      "old": "不能仅凭日期标签",
      "new": "可以仅凭日期标签",
      "expected_red": ["test_foreign_calendar_label_does_not_prove_publication_before_cutoff"]
    },
    {
      "name": "ratio label loses its denominator",
      "old": "_metric(\"limit_up_ratio\", \"板块内涨停占比%\")",
      "new": "_metric(\"limit_up_ratio\", \"涨停占比\")",
      "expected_red": ["test_heat_evidence_names_both_denominators_without_changing_values"]
    },
    {
      "name": "market share uses the other denominator",
      "old": "market_share=limit_up_count/market_limit_up_count×100",
      "new": "market_share=limit_up_count/total_count×100",
      "expected_red": ["test_heat_evidence_names_both_denominators_without_changing_values"]
    },
    {
      "name": "ladder rate becomes an individual probability",
      "old": "_dimension(\"promotion_rate\", \"同板位晋级率（非个股概率）\")",
      "new": "_dimension(\"promotion_rate\", \"个股晋级概率\")",
      "expected_red": ["test_ladder_evidence_distinguishes_survivors_from_cohort_success"]
    },
    {
      "name": "coverage note is removed from discovery",
      "old": "{definition.coverage}{definition.interpretation_note}",
      "new": "{definition.coverage}",
      "expected_red": [
        "test_catalog_and_executed_basis_share_the_measurement_note[theme_limit_heat_daily]",
        "test_catalog_and_executed_basis_share_the_measurement_note[limit_advance_daily]"
      ]
    },
    {
      "name": "interpretation only lives in prunable prose",
      "file": "intelligence/services/episode_tools.py",
      "old": "**({\"interpretation_note\": note} if note else {}),",
      "new": "**({\"interpretation_note\": note} if False else {}),",
      "expected_red": [
        "test_measurement_note_reaches_actual_model_view_after_pruning[theme_limit_heat_daily-off]",
        "test_measurement_note_reaches_actual_model_view_after_pruning[theme_limit_heat_daily-on]",
        "test_measurement_note_reaches_actual_model_view_after_pruning[limit_advance_daily-off]",
        "test_measurement_note_reaches_actual_model_view_after_pruning[limit_advance_daily-on]"
      ]
    },
    {
      "name": "group aggregates pretend to be raw row formulas",
      "old": "note = definition.interpretation_note\n    if spec.group_by:",
      "new": "note = definition.interpretation_note\n    if False:",
      "expected_red": [
        "test_grouped_heat_discloses_aggregation_not_a_recomputed_union_ratio",
        "test_grouped_ladder_does_not_turn_maximum_into_each_stock_height"
      ]
    },
    {
      "name": "engine omits the interpretation",
      "old": "note = interpretation_note(spec)\n        if note:",
      "new": "note = interpretation_note(spec)\n        if False:",
      "expected_red": [
        "test_catalog_and_executed_basis_share_the_measurement_note[theme_limit_heat_daily]",
        "test_catalog_and_executed_basis_share_the_measurement_note[limit_advance_daily]"
      ]
    }
  ]
}
