#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import date
from pathlib import Path

KB_ROOT = Path("/Users/lbq/Desktop/c c/知识库")
RAW_DIR = KB_ROOT / "raw"
WIKI_DIR = KB_ROOT / "wiki"
SOURCES_DIR = WIKI_DIR / "sources"
LOG_PATH = WIKI_DIR / "log.md"
INDEX_PATH = WIKI_DIR / "index.md"
RELATIONS_DIR = WIKI_DIR / "relations"
UNCERTAIN_MARKERS = (
    "未证实", "未确认", "传言", "网传", "网上传闻", "网络消息", "盘中消息", "盘后消息",
    "市场挖掘", "调研", "据行业", "据产业", "机构测算", "不作任何保证", "仅供参考", "风险",
)
THEME_KEYWORDS = (
    "DeepSeek", "AI", "算力", "云计算", "边缘计算", "CDN", "液冷", "机器人", "低空经济", "商业航天",
    "光模块", "CPO", "PCB", "电子布", "半导体", "先进封装", "存储", "数据中心", "电力", "燃气轮机",
    "稀土", "固态电池", "光刻胶", "IP", "短剧", "漫剧", "游戏", "储能", "核电", "油气", "玻纤",
)


def normalize_source_name(pdf: Path, explicit: str = "") -> str:
    return (explicit or pdf.stem).replace(" ", "").replace("　", "")


def infer_source_date(pdf: Path, explicit: str = "") -> str:
    if explicit:
        return explicit
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", pdf.parent.name):
        return pdf.parent.name
    match = re.search(r"(20\d{2})(\d{2})(\d{2})", pdf.stem)
    if match:
        return f"{match.group(1)}-{match.group(2)}-{match.group(3)}"
    return str(date.today())


def extract_text(pdf: Path) -> tuple[str, str]:
    errors = []
    try:
        from pypdf import PdfReader
        chunks = []
        for i, page in enumerate(PdfReader(str(pdf)).pages, 1):
            chunks.append(f"\n\n===== PAGE {i} =====\n\n" + (page.extract_text() or ""))
        text = "".join(chunks)
        if len(text.strip()) >= 200:
            return text, "文本层提取完成"
    except Exception as exc:
        errors.append(f"pypdf: {exc}")
    try:
        import fitz
        doc = fitz.open(str(pdf))
        chunks = []
        for i, page in enumerate(doc, 1):
            chunks.append(f"\n\n===== PAGE {i} =====\n\n" + page.get_text())
        text = "".join(chunks)
        if len(text.strip()) >= 200:
            return text, "文本层提取完成"
    except Exception as exc:
        errors.append(f"fitz: {exc}")
    try:
        from pdf2image import convert_from_path
        import pytesseract
        chunks = []
        pages = convert_from_path(str(pdf), dpi=220)
        for i, image in enumerate(pages, 1):
            chunks.append(f"\n\n===== PAGE {i} =====\n\n" + pytesseract.image_to_string(image, lang="chi_sim+eng", config="--psm 6"))
        text = "".join(chunks)
        if len(text.strip()) >= 200:
            return text, "OCR 已完成"
    except Exception as exc:
        errors.append(f"ocr: {exc}")
    raise RuntimeError("PDF text extraction failed: " + "; ".join(errors))


def clean_line(line: str) -> str:
    line = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", line)
    line = re.sub(r"\s+", " ", line).strip()
    return line


def meaningful_lines(text: str) -> list[str]:
    lines = []
    for raw in text.splitlines():
        line = clean_line(raw)
        if len(line) < 8:
            continue
        if line.startswith("====="):
            continue
        lines.append(line)
    return lines


def pick_excerpts(lines: list[str], limit: int = 7) -> list[str]:
    excerpts = []
    for line in lines:
        if any(marker in line for marker in ("特别提示", "风险", "未确认", "未证实", "传言", "市场挖掘", "逻辑核心")):
            excerpts.append(line[:180])
        if len(excerpts) >= limit:
            break
    if len(excerpts) < 3:
        for line in lines[:20]:
            if line not in excerpts:
                excerpts.append(line[:180])
            if len(excerpts) >= limit:
                break
    return excerpts


def extract_themes(text: str) -> list[str]:
    found = []
    for keyword in THEME_KEYWORDS:
        if keyword.lower() in text.lower():
            found.append(keyword)
    headings = []
    for line in meaningful_lines(text):
        if 4 <= len(line) <= 28 and not re.search(r"[。；，,]", line):
            if any(token in line for token in ("：", "&", "AI", "DeepSeek", "液冷", "算力", "云计算", "边缘计算")):
                headings.append(line.replace(" ", ""))
    merged = []
    for item in found + headings:
        if item not in merged:
            merged.append(item)
    return merged[:18]


def extract_companies(text: str, limit: int = 50) -> list[str]:
    names = []
    patterns = [
        r"[•\-]\s*([^：:（）()\s]{2,12})[（(][^）)]{2,20}[）)]：",
        r"[•\-]\s*([^：:（）()\s]{2,12})：",
        r"（相关个股：([^）]+)）",
        r"（([^）]{2,80})等）",
    ]
    for pattern in patterns:
        for match in re.finditer(pattern, text):
            value = match.group(1)
            for part in re.split(r"[、/，,\s]+", value):
                part = clean_line(part)
                if 2 <= len(part) <= 12 and not any(ch.isdigit() for ch in part) and part not in names:
                    names.append(part)
                if len(names) >= limit:
                    return names
    return names


def next_log_id() -> int:
    text = LOG_PATH.read_text(encoding="utf-8") if LOG_PATH.exists() else ""
    ids = [int(x) for x in re.findall(r"^### #(\d+) \|", text, re.M)]
    return max(ids) + 1 if ids else 1


def append_log(log_id: int, source: str, source_date: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    entry = f"""
### #{log_id:03d} | {date.today().isoformat()} | ingest | {source} PDF ingest

- **trigger**: automated hbs source-only PDF ingest queue
- **source**: [[{source}]]（逻辑红宝书，{source_date}）
- **created**: [[{source}]] (source note), `raw/{source}.md`
- **updated**: [[index.md]] (revision/count)
- **key**: {source}为市场逻辑/传言型材料，含市场机会、题材映射、盘后消息、网络/产业调研或传言补充等混合口径。保守入库为source-only observation，不写entity边际变化，不写Theme Radar relations。
"""
    existing = LOG_PATH.read_text(encoding="utf-8") if LOG_PATH.exists() else ""
    if f"[[{source}]]" not in existing:
        LOG_PATH.write_text(existing.rstrip() + "\n" + entry, encoding="utf-8")


def update_index(log_id: int, source: str) -> None:
    text = INDEX_PATH.read_text(encoding="utf-8")
    sources = len(list((WIKI_DIR / "sources").glob("*.md")))
    concepts = len(list((WIKI_DIR / "concepts").glob("*.md")))
    entities = len(list((WIKI_DIR / "entities").glob("*.md")))
    synthesis = len(list((WIKI_DIR / "synthesis").glob("*.md")))
    total = sources + concepts + entities + synthesis
    text = re.sub(r"^updated:\s*.*$", f"updated: {date.today().isoformat()}", text, count=1, flags=re.M)
    rev_match = re.search(r"^revision:\s*(\d+)\s*$", text, re.M)
    if rev_match:
        revision = int(rev_match.group(1)) + 1
        text = re.sub(r"^revision:\s*\d+\s*$", f"revision: {revision}", text, count=1, flags=re.M)
    log_entry = f"#{log_id:03d} PDF ingest: {source}"
    if log_entry not in text:
        text = re.sub(r"^log: \[(.*)\]$", lambda m: f"log: [{m.group(1)}, {json.dumps(log_entry, ensure_ascii=False)}]", text, count=1, flags=re.M)
    text = re.sub(r"\*\*\d+ 页 \| \d+ 个来源 \| \d+ 个概念 \| \d+ 个实体 \| \d+ 个综合分析\*\*", f"**{total} 页 | {sources} 个来源 | {concepts} 个概念 | {entities} 个实体 | {synthesis} 个综合分析**", text, count=1)
    text = re.sub(r"## Sources（\d+个）", f"## Sources（{sources}个）", text, count=1)
    INDEX_PATH.write_text(text, encoding="utf-8")


def write_source_note(source: str, source_date: str, pdf: Path, status: str, text: str, log_id: int) -> Path:
    source_path = SOURCES_DIR / f"{source}.md"
    if source_path.exists():
        return source_path
    lines = meaningful_lines(text)
    excerpts = pick_excerpts(lines)
    themes = extract_themes(text)
    companies = extract_companies(text)
    uncertainty = [marker for marker in UNCERTAIN_MARKERS if marker in text]
    theme_text = "、".join(themes) if themes else "市场热点、机会前瞻、大涨分析、市场挖掘及传言补充"
    uncertainty_text = "、".join(uncertainty[:10]) if uncertainty else "风险提示、市场叙事、二手信息"
    company_text = "、".join(companies[:30]) if companies else "详见 raw 原文中的相关公司与个股信息"
    body = [
        "---",
        f"title: {json.dumps(source, ensure_ascii=False)}",
        "type: source",
        f"source_date: {source_date}",
        f"created: {date.today().isoformat()}",
        f"updated: {date.today().isoformat()}",
        "revision: 1",
        "source_quality: market_narrative",
        f"sources: [\"[[{source}]]\"]",
        f"log: [\"#{log_id:03d} PDF ingest source-only observation\"]",
        "---",
        "",
        f"# {source}",
        "",
        f"本地文件：`{pdf}`",
        f"Raw 文件：`raw/{source}.md`",
        "",
        "## 入库记录",
        "",
        f"- 处理日期：{date.today().isoformat()}",
        "- 使用脚本：hbs_market_logic_worker.py",
        f"- 处理状态：{status}",
        f"- 入库判断：市场逻辑/传言材料，识别到 {uncertainty_text} 等口径；本轮保守处理为观察列表，不写 entity 边际变化，不写 relations。",
        "",
        "## 摘要",
        "",
        f"本篇围绕 {theme_text} 等主题，整理市场机会、题材映射、大涨分析和市场挖掘信息。由于材料定位为市场逻辑精选，且存在 {uncertainty_text} 等不确定或二手口径，本轮仅作为观察型 source 入库。",
        "",
        "## 关键摘录",
        "",
    ]
    for excerpt in excerpts:
        body.append(f"- “{excerpt}”")
    body.extend([
        "",
        "## 观察列表",
        "",
        f"- 涉及主题：{theme_text}；本轮仅保留为市场叙事观察，不写入 relations。",
        f"- 涉及公司/个股：{company_text}；其中具体业务、订单、客户、产能、业绩或传闻信息均需回看原始披露或公告验证，本轮不写 entity 正文。",
        "- source note 仅用于后续人工检索和题材线索回看；不作为 Theme Radar 底层公司暴露证据。",
        "",
    ])
    source_path.write_text("\n".join(body), encoding="utf-8")
    return source_path


def assert_no_relation_hits(source: str) -> None:
    for path in RELATIONS_DIR.glob("*.json"):
        data = json.loads(path.read_text(encoding="utf-8"))
        text = json.dumps(data, ensure_ascii=False)
        if source in text or f"[[{source}]]" in text:
            raise RuntimeError(f"source-only worker must not write relations, but found source in {path.name}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Single-file hbs 市场逻辑精选 source-only ingest worker.")
    parser.add_argument("--pdf", type=Path, required=True)
    parser.add_argument("--source", default="")
    parser.add_argument("--date", default="")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()

    pdf = args.pdf.expanduser().resolve()
    if not pdf.exists():
        raise FileNotFoundError(pdf)
    source = normalize_source_name(pdf, args.source)
    source_date = infer_source_date(pdf, args.date)
    raw_path = RAW_DIR / f"{source}.md"
    source_path = SOURCES_DIR / f"{source}.md"
    if not args.force and raw_path.exists() and source_path.exists():
        print(json.dumps({"status": "skipped_existing", "source": source, "raw": str(raw_path), "source_note": str(source_path)}, ensure_ascii=False, indent=2))
        return 0
    if "市场逻辑精选" not in source:
        raise RuntimeError(f"hbs source-only worker only handles 市场逻辑精选 files, got: {source}")

    text, status = extract_text(pdf)
    RAW_DIR.mkdir(parents=True, exist_ok=True)
    SOURCES_DIR.mkdir(parents=True, exist_ok=True)
    raw_path.write_text(text, encoding="utf-8")
    if raw_path.stat().st_size == 0:
        raise RuntimeError(f"raw file empty: {raw_path}")
    log_id = next_log_id()
    write_source_note(source, source_date, pdf, status, text, log_id)
    append_log(log_id, source, source_date)
    update_index(log_id, source)
    assert_no_relation_hits(source)
    print(json.dumps({"status": "ok", "source": source, "source_date": source_date, "log_id": f"#{log_id:03d}", "raw": str(raw_path), "source_note": str(source_path)}, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
