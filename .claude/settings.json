{
  "_why_portable_hooks": "原先写死 /Users/a77/finance-workspace-private/...。云端 Linux 该路径不存在；dash 对打不开的文件 exit 2，Claude Code 把 2 当成 hook blocked。现用 CLAUDE_PROJECT_DIR + 存在才执行 + 永远 exit 0。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${CLAUDE_PROJECT_DIR:-${DEVIN_PROJECT_DIR:-.}}\"; SH=\"$ROOT/.claude/hooks/load-memory.sh\"; [ -f \"$SH\" ] && bash \"$SH\"; exit 0"
          },
          {
            "type": "command",
            "command": "ROOT=\"${CLAUDE_PROJECT_DIR:-${DEVIN_PROJECT_DIR:-.}}\"; SH=\"$ROOT/scripts/session_facts.sh\"; [ -f \"$SH\" ] && bash \"$SH\"; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${CLAUDE_PROJECT_DIR:-${DEVIN_PROJECT_DIR:-.}}\"; SH=\"$ROOT/scripts/check_inflight_stale.sh\"; [ -f \"$SH\" ] && bash \"$SH\"; exit 0"
          }
        ]
      }
    ]
  }
}
