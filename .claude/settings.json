{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/a77/finance-workspace-private/.claude/hooks/load-memory.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/a77/finance-workspace-private/scripts/session_facts.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/a77/finance-workspace-private/scripts/check_inflight_stale.sh"
          }
        ]
      }
    ]
  }
}
